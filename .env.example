# Example only. Copy to the appropriate local environment file and replace secrets.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/casefile
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
SESSION_MAX_AGE=86400000
FRONTEND_URL=http://localhost:5173

# If frontend and backend use separate environment files, set VITE_API_BASE_URL
# in the frontend environment, for example:
# VITE_API_BASE_URL=http://localhost:5000/api/v1
